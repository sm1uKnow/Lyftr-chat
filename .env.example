# Copy to .env and replace both placeholders with real keys.
LLM_API_KEYS=replace_with_key_1,replace_with_key_2
# Set one LiteLLM model for every key, or one model per key in the same order.
LLM_MODELS=gemini/gemini-3.1-flash-lite
LLM_REQUEST_TIMEOUT_SECONDS=15
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
VITE_API_BASE_URL=http://localhost:8000
# Container listens on this port. Railway can inject PORT for you.
PORT=8000
